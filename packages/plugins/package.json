{
	"name": "@omni-svelte/plugins",
	"version": "0.1.0",
	"private": true,
	"description": "Official plugin stubs for omni-svelte (logging, cors, analytics, error reporting).",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./logging": {
			"types": "./dist/logging/index.d.ts",
			"default": "./dist/logging/index.js"
		},
		"./cors": {
			"types": "./dist/cors/index.d.ts",
			"default": "./dist/cors/index.js"
		},
		"./analytics": {
			"types": "./dist/analytics/index.d.ts",
			"default": "./dist/analytics/index.js"
		},
		"./error-reporting": {
			"types": "./dist/error-reporting/index.d.ts",
			"default": "./dist/error-reporting/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"check": "tsc --noEmit",
		"format": "vp fmt .",
		"lint": "vp fmt --check . && vp lint ."
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"@omni-svelte/shared": "workspace:*",
		"@sveltejs/kit": "^3.0.0-next.12"
	},
	"devDependencies": {
		"@types/node": "^24",
		"globals": "^17.3.0",
		"typescript": "^5.0.0",
		"vite-plus": "catalog:"
	},
	"keywords": [
		"svelte",
		"omni-svelte",
		"plugins"
	]
}
