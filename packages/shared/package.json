{
	"name": "@omni-svelte/shared",
	"version": "0.1.0",
	"private": true,
	"description": "Shared utilities for omni-svelte.",
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack",
		"format": "vp fmt .",
		"lint": "vp fmt --check . && vp lint ."
	},
	"files": [
		"dist"
	],
	"devDependencies": {
		"typescript": "^5.0.0",
		"vite-plus": "catalog:"
	},
	"dependencies": {
		"@sveltejs/kit": "^3.0.0-next.12"
	}
}
